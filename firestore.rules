rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Regras para a aplicação Financeiro Refeições
    // Coleção base e todas as subcoleções isoladas pelo UID do usuário autenticado:
    match /gestao-financeira/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /{allSubcollections=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
